# /home/kenneth-copeland/Documents/WealthTrackr/backend/.env.example
# Copy this file to .env and fill in your actual values

# =====================================================
# APPLICATION SETTINGS
# =====================================================
WEALTHTRACKR_APP_NAME="WealthTrackr API"
WEALTHTRACKR_APP_VERSION="2.0.0"
WEALTHTRACKR_DEBUG=false
WEALTHTRACKR_ENVIRONMENT=development

# =====================================================
# DATABASE SETTINGS
# =====================================================
WEALTHTRACKR_DATABASE_URL=postgresql://zack:newsecurepassword@localhost:5432/wealthtrackr
WEALTHTRACKR_DATABASE_ECHO=false

# =====================================================
# SECURITY SETTINGS
# =====================================================
WEALTHTRACKR_SECRET_KEY=your-super-secret-key-change-this-in-production
WEALTHTRACKR_JWT_ALGORITHM=HS256
WEALTHTRACKR_ACCESS_TOKEN_EXPIRE_MINUTES=60
WEALTHTRACKR_REFRESH_TOKEN_EXPIRE_DAYS=14

# Password requirements
WEALTHTRACKR_MIN_PASSWORD_LENGTH=8
WEALTHTRACKR_REQUIRE_PASSWORD_COMPLEXITY=true

# Account lockout settings
WEALTHTRACKR_MAX_FAILED_LOGIN_ATTEMPTS=5
WEALTHTRACKR_ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# =====================================================
# EMAIL SETTINGS (for verification, password reset, etc.)
# =====================================================
WEALTHTRACKR_SMTP_SERVER=smtp.gmail.com
WEALTHTRACKR_SMTP_PORT=587
WEALTHTRACKR_SMTP_USE_TLS=true
WEALTHTRACKR_EMAIL_USER=your-email@gmail.com
WEALTHTRACKR_EMAIL_PASSWORD=your-app-password
WEALTHTRACKR_EMAIL_FROM=your-email@gmail.com
WEALTHTRACKR_EMAIL_FROM_NAME=WealthTrackr

# Email verification settings
WEALTHTRACKR_EMAIL_VERIFICATION_EXPIRE_HOURS=24
WEALTHTRACKR_PASSWORD_RESET_EXPIRE_HOURS=2

# =====================================================
# AI & EXTERNAL API SETTINGS
# =====================================================
WEALTHTRACKR_OPENAI_API_KEY=sk-your-openai-api-key-here
WEALTHTRACKR_OPENAI_MODEL=gpt-3.5-turbo
WEALTHTRACKR_OPENAI_MAX_TOKENS=1000
WEALTHTRACKR_OPENAI_TEMPERATURE=0.7

# Financial data APIs (optional)
WEALTHTRACKR_ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
WEALTHTRACKR_POLYGON_API_KEY=your-polygon-key

# =====================================================
# CORS SETTINGS
# =====================================================
WEALTHTRACKR_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
WEALTHTRACKR_CORS_ALLOW_CREDENTIALS=true

# =====================================================
# FILE UPLOAD SETTINGS
# =====================================================
WEALTHTRACKR_MAX_FILE_SIZE_MB=10
WEALTHTRACKR_UPLOAD_DIRECTORY=uploads

# =====================================================
# REDIS SETTINGS (for caching and background tasks)
# =====================================================
WEALTHTRACKR_REDIS_URL=redis://localhost:6379/0
WEALTHTRACKR_REDIS_EXPIRE_SECONDS=3600

# =====================================================
# LOGGING SETTINGS
# =====================================================
WEALTHTRACKR_LOG_LEVEL=INFO
WEALTHTRACKR_LOG_FILE=logs/wealthtrackr.log

# =====================================================
# FEATURE FLAGS
# =====================================================
WEALTHTRACKR_ENABLE_AI_FEATURES=true
WEALTHTRACKR_ENABLE_EMAIL_VERIFICATION=true
WEALTHTRACKR_ENABLE_TWO_FACTOR_AUTH=true
WEALTHTRACKR_ENABLE_BIOMETRIC_AUTH=true
WEALTHTRACKR_ENABLE_SOCIAL_LOGIN=false
WEALTHTRACKR_ENABLE_PREMIUM_FEATURES=true
WEALTHTRACKR_ENABLE_ANALYTICS=true
WEALTHTRACKR_ENABLE_BACKGROUND_TASKS=true

# =====================================================
# RATE LIMITING
# =====================================================
WEALTHTRACKR_RATE_LIMIT_PER_MINUTE=100
WEALTHTRACKR_RATE_LIMIT_BURST=200

# =====================================================
# MONITORING & HEALTH CHECKS
# =====================================================
WEALTHTRACKR_HEALTH_CHECK_INTERVAL_SECONDS=30
WEALTHTRACKR_ENABLE_METRICS=true
WEALTHTRACKR_METRICS_PORT=9090

# =====================================================
# LEGACY COMPATIBILITY (for your existing setup)
# =====================================================
# These will be automatically mapped to the new settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGIN=http://localhost:3000
SMTP_SERVER=smtp.gmail.com
EMAIL_USER=your-email@gmail.com
