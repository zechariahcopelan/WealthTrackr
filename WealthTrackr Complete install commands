# WealthTrackr Complete System Setup Guide
# Run these commands on a fresh Ubuntu system

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 1: SYSTEM UPDATE AND BASIC TOOLS
# ═══════════════════════════════════════════════════════════════════════════════

sudo apt update && sudo apt upgrade -y
sudo apt install -y curl wget git vim nano tree htop

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 2: PYTHON SETUP
# ═══════════════════════════════════════════════════════════════════════════════

# Install Python 3.12 and pip
sudo apt install -y python3.12 python3.12-venv python3.12-dev python3-pip

# Create symbolic links (if needed)
sudo ln -sf /usr/bin/python3.12 /usr/bin/python3
sudo ln -sf /usr/bin/python3.12 /usr/bin/python

# Verify Python installation
python3 --version
pip3 --version

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 3: POSTGRESQL DATABASE SETUP
# ═══════════════════════════════════════════════════════════════════════════════

# Install PostgreSQL
sudo apt install -y postgresql postgresql-contrib

# Start PostgreSQL service
sudo systemctl start postgresql
sudo systemctl enable postgresql

# Create database and user
sudo -u postgres psql << EOF
CREATE DATABASE wealthtrackr;
CREATE USER zack WITH PASSWORD 'newsecurepassword';
GRANT ALL PRIVILEGES ON DATABASE wealthtrackr TO zack;
ALTER USER zack CREATEDB;
\q
EOF

# Test database connection
psql -d wealthtrackr -U zack -h localhost -c "SELECT version();"

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 4: SYSTEM DEPENDENCIES FOR PYTHON PACKAGES
# ═══════════════════════════════════════════════════════════════════════════════

# For python-magic (file type detection)
sudo apt install -y libmagic1

# For Pillow (image processing)
sudo apt install -y libjpeg-dev zlib1g-dev libpng-dev

# For psycopg2 (PostgreSQL adapter)
sudo apt install -y libpq-dev

# For general development
sudo apt install -y build-essential

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 5: PROJECT DIRECTORY AND VIRTUAL ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Create project directory
mkdir -p ~/Documents/WealthTrackr
cd ~/Documents/WealthTrackr

# Create virtual environment
python3 -m venv venv

# Activate virtual environment
source venv/bin/activate

# Upgrade pip in virtual environment
pip install --upgrade pip

